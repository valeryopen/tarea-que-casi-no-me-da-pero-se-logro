let a = 10;
let b = 5;

console.log(a == b);
console.log(a === b);
console.log(a != b);
console.log(a !== b);
console.log(a > b);
console.log(a < b);
console.log(a >= b);
console.log(a <= b);

console.log(5 == "5"); 
console.log(5 === "5");

// == compara los valores.
// === compara el valor y también el tipo de dato.
